# Copie este arquivo para ".env" e preencha com suas chaves reais.
# O ".env" de verdade nunca sobe pro GitHub (fica fora do repositorio).

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# banco de dados (Supabase) - Project Settings -> API no painel do Supabase.
# SUPABASE_SERVICE_KEY e a chave "secret" (sb_secret_...), nunca a "publishable".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# codigo pra ativar o modo administrador (Configuracoes -> Modo administrador)
ADMIN_CODE=

# sessao de login - troque por um valor aleatorio proprio antes de publicar
SESSION_SECRET=

PORT=3000

# ---- guardrails de custo do TTS (audio) ----
TTS_GLOBAL_MONTHLY_CHAR_CAP=3000000
TTS_FREE_PLAN_CHAR_LIMIT=13500
TTS_PLUS_PLAN_CHAR_LIMIT=270000
TTS_PREMIUM_PLAN_CHAR_LIMIT=540000
TTS_RATE_LIMIT_PER_HOUR=5
TTS_MAX_DOCUMENT_CHARS=200000

# opcional: webhook (Slack/Discord) pra receber alertas automaticos
FOUNDER_ALERT_WEBHOOK=
